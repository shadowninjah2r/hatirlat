name: HATIRLAT APK Build

on:
  workflow_dispatch:
  push:
    paths:
      - 'HatirlatAndroid_KaynakKodu_DUZELTILMIS.zip'
      - '.github/workflows/build.yml'

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Get source
        uses: actions/checkout@v4

      - name: Install Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Extract project
        run: |
          unzip -q HatirlatAndroid_KaynakKodu_DUZELTILMIS.zip -d source
          test -f source/settings.gradle.kts
          test -f source/app/build.gradle.kts

      - name: Build debug APK
        run: gradle -p source assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: HATIRLAT-APK
          path: source/app/build/outputs/apk/debug/*.apk
          if-no-files-found: error
